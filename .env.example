# Groq API Configuration
# Replace with your actual Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Supported configurable model ID (default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# CORS Configuration for Shopify Development Storefronts
# Comma-separated list of additional allowed origins (e.g. https://my-dev-store.myshopify.com)
# Localhost and *.myshopify.com dev origins are supported out-of-the-box.
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:9292,https://quickstart-c7c49df2.myshopify.com

# Shopify Partner App Credentials (optional for local API, required for app deployment / seeding)
SHOPIFY_API_KEY=your_shopify_client_id_here
SHOPIFY_API_SECRET=your_shopify_client_secret_here

